<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HdrImageViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:HdrImageViewer.Pages"
    Title="HDR Image Viewer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Loaded="WindowRoot_Loaded" KeyDown="WindowRoot_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.Content>
                <Grid x:Name="ViewerTitleContent" ColumnSpacing="12" SizeChanged="ViewerTitleContent_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ViewerCommandsHost" VerticalAlignment="Center" SizeChanged="ViewerCommandsHost_SizeChanged" />
                    <TextBlock x:Name="ViewerFileName" Grid.Column="1"
                               AutomationProperties.AutomationId="ViewerFileName"
                               Margin="0,0,12,0" VerticalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <Grid Grid.Row="1">
            <pages:HomePage x:Name="ViewerPage" />
            <Frame
                x:Name="NavFrame"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
