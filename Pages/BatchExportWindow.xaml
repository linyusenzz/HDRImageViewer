<Window
    x:Class="HdrImageViewer.Pages.BatchExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:HdrImageViewer.Services">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TitleBar x:Name="BatchTitleBar" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Grid Padding="24" RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="BatchExportPendingImages" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="FileCountText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="AddFilesButton" Click="AddFiles_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock x:Uid="BatchExportAdd" /></StackPanel>
                        </Button>
                        <Button x:Name="RemoveButton" Click="Remove_Click" Width="32" Padding="0"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                        <Button x:Name="ClearButton" Click="Clear_Click" Width="32" Padding="0"><FontIcon Glyph="&#xE894;" FontSize="14" /></Button>
                    </StackPanel>
                </Grid>
                <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:BatchExportItem">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="44" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FileName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind StateLabel, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="QueueEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xEB9F;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Uid="BatchExportEmptyTitle" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="BatchExportEmptySubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        <TextBlock x:Uid="BatchExportSettings" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="FormatSelector" x:Uid="BatchExportFormat" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Format_SelectionChanged">
                            <ComboBoxItem x:Name="BatchFormatItemSdrPng" />
                            <ComboBoxItem x:Name="BatchFormatItemSdrJpeg" />
                            <ComboBoxItem x:Name="BatchFormatItemGainMapJpeg" />
                            <ComboBoxItem x:Name="BatchFormatItemHdrPq" />
                            <ComboBoxItem x:Name="BatchFormatItemHdrHlg" />
                            <ComboBoxItem x:Name="BatchFormatItemHdrTiff" />
                            <ComboBoxItem x:Name="BatchFormatItemOpenExr" />
                            <ComboBoxItem x:Name="BatchFormatItemOriginal" />
                            <ComboBoxItem x:Name="BatchFormatItemGainMapHeic" />
                            <ComboBoxItem x:Name="BatchFormatItemGainMapAvif" />
                        </ComboBox>
                        <TextBlock x:Name="FormatNoteText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="BatchExportSaveTo" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="FolderButton" Click="Folder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    <TextBlock x:Name="FolderText" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="BatchExportNaming" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="BatchExportPatternExample" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="BatchExportNamingTip" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Uid="BatchExportHelpButton" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left">
                            <Button.Flyout><Flyout><TextBlock x:Uid="BatchExportHelpContent" MaxWidth="280" TextWrapping="Wrap" /></Flyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="24,16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ProgressBar x:Name="QueueProgress" Minimum="0" Maximum="1" Visibility="Collapsed" />
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RetryButton" x:Uid="BatchExportRetry" Click="Retry_Click" Visibility="Collapsed" />
                        <Button x:Name="CancelButton" x:Uid="BatchExportCancel" Click="Cancel_Click" Visibility="Collapsed" />
                        <Button x:Name="StartButton" x:Uid="BatchExportStart" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" MinWidth="112" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
