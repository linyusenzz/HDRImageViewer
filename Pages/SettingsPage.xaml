<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HdrImageViewer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="SettingsExpanderStyle"
            TargetType="Expander">
            <Setter Property="MaxWidth" Value="640" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="24,16,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="SettingsContent"
                MaxWidth="640"
                Padding="12"
                HorizontalAlignment="Stretch"
                Spacing="16">
            <TextBlock
                x:Uid="SettingsPageTitle"
                Style="{StaticResource TitleTextBlockStyle}" />

            <Expander
                x:Uid="SettingsInteractionExpander"
                IsExpanded="True"
                Style="{StaticResource SettingsExpanderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="MouseWheelBehaviorSelector"
                        x:Uid="SettingsMouseWheelBehaviorSelector"
                        AutomationProperties.AutomationId="MouseWheelBehaviorSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="MouseWheelBehaviorSelector_SelectionChanged">
                        <ComboBoxItem x:Name="MouseWheelNavigateItem" />
                        <ComboBoxItem x:Name="MouseWheelZoomItem" />
                    </ComboBox>
                    <ToggleSwitch
                        x:Name="TouchpadGesturesToggle"
                        x:Uid="SettingsTouchpadGesturesToggle"
                        AutomationProperties.AutomationId="TouchpadGesturesToggle"
                        Toggled="TouchpadGesturesToggle_Toggled" />
                </StackPanel>
            </Expander>

            <Expander
                x:Uid="SettingsPerformanceExpander"
                IsExpanded="True"
                Style="{StaticResource SettingsExpanderStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch
                        x:Name="PreloadAdjacentImagesToggle"
                        x:Uid="SettingsPreloadAdjacentImagesToggle"
                        AutomationProperties.AutomationId="PreloadAdjacentImagesToggle"
                        Toggled="PreloadAdjacentImagesToggle_Toggled" />
                    <NumberBox
                        x:Name="AdjacentPreloadRadiusBox"
                        x:Uid="SettingsAdjacentPreloadRadiusBox"
                        AutomationProperties.AutomationId="AdjacentPreloadRadiusBox"
                        Minimum="1"
                        Maximum="12"
                        SmallChange="1"
                        LargeChange="2"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="AdjacentPreloadRadiusBox_ValueChanged" />
                </StackPanel>
            </Expander>

            <Expander
                x:Uid="SettingsInterfaceExpander"
                IsExpanded="True"
                Style="{StaticResource SettingsExpanderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="LanguageSelector"
                        x:Uid="SettingsLanguageSelector"
                        AutomationProperties.AutomationId="LanguageSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem x:Name="LanguageSystemItem" Tag="" />
                        <ComboBoxItem Content="中文（简体）" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                        <ComboBoxItem Content="Русский" Tag="ru-RU" />
                        <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                        <ComboBoxItem Content="Français" Tag="fr-FR" />
                        <ComboBoxItem Content="Español" Tag="es-ES" />
                        <ComboBoxItem Content="Italiano" Tag="it-IT" />
                        <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
                        <ComboBoxItem Content="日本語" Tag="ja-JP" />
                        <ComboBoxItem Content="한국어" Tag="ko-KR" />
                        <ComboBoxItem Content="Polski" Tag="pl-PL" />
                        <ComboBoxItem Content="Українська" Tag="uk-UA" />
                    </ComboBox>
                    <InfoBar
                        x:Name="LanguageRestartInfoBar"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="RestartNowButton"
                                x:Uid="SettingsRestartNow"
                                Click="RestartNowButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <ComboBox
                        x:Name="ThemeSelector"
                        x:Uid="SettingsThemeSelector"
                        AutomationProperties.AutomationId="ThemeSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem x:Name="ThemeSystemItem" />
                        <ComboBoxItem x:Name="ThemeLightItem" />
                        <ComboBoxItem x:Name="ThemeDarkItem" />
                    </ComboBox>
                    <ToggleSwitch
                        x:Name="ShowInspectorPanelToggle"
                        x:Uid="SettingsShowInspectorPanelToggle"
                        AutomationProperties.AutomationId="ShowInspectorPanelToggle"
                        Toggled="ShowInspectorPanelToggle_Toggled" />
                    <ToggleSwitch
                        x:Name="ShowFilmstripToggle"
                        x:Uid="SettingsShowFilmstripToggle"
                        AutomationProperties.AutomationId="ShowFilmstripToggle"
                        Toggled="ShowFilmstripToggle_Toggled" />
                </StackPanel>
            </Expander>

            <Expander
                x:Uid="SettingsDisplayExpander"
                IsExpanded="True"
                Style="{StaticResource SettingsExpanderStyle}">
                <StackPanel Spacing="12">
                    <ComboBox
                        x:Name="ColorGamutMappingModeSelector"
                        x:Uid="SettingsColorGamutMappingModeSelector"
                        AutomationProperties.AutomationId="ColorGamutMappingModeSelector"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="ColorGamutMappingModeSelector_SelectionChanged">
                        <ComboBoxItem x:Name="GamutManagedItem" />
                        <ComboBoxItem x:Name="GamutClipItem" />
                    </ComboBox>
                </StackPanel>
            </Expander>

            <Expander
                x:Uid="SettingsSystemExpander"
                IsExpanded="False"
                Style="{StaticResource SettingsExpanderStyle}">
                <StackPanel Spacing="12">
                    <Button
                        x:Name="OpenDefaultAppsSettingsButton"
                        x:Uid="SettingsOpenDefaultAppsButton"
                        AutomationProperties.AutomationId="OpenDefaultAppsSettingsButton"
                        Click="OpenDefaultAppsSettings_Click"
                        HorizontalAlignment="Stretch">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE713;" />
                            <TextBlock x:Uid="SettingsDefaultAppsText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
