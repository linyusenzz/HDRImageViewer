<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="HdrImageViewer.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="SettingsContent.Padding" Value="16,12,16,24" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="SettingsContent.Padding" Value="32,12,32,32" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer AutomationProperties.AutomationId="SettingsScrollViewer" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="SettingsContent" HorizontalAlignment="Stretch" Spacing="24" Padding="32,12,32,32">
                <TextBlock x:Uid="SettingsPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Spacing="8">
                <TextBlock x:Name="PersonalizationHeading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                <controls:SettingsCard x:Name="ThemeCard" x:Uid="SettingsThemeSelector" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></controls:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160" MaxWidth="240"
                        x:Name="ThemeSelector"
                        AutomationProperties.AutomationId="ThemeSelector"
                        HorizontalAlignment="Right"
                        SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem x:Name="ThemeSystemItem" />
                        <ComboBoxItem x:Name="ThemeLightItem" />
                        <ComboBoxItem x:Name="ThemeDarkItem" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="LanguageCard" x:Uid="SettingsLanguageSelector" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></controls:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160" MaxWidth="240"
                        x:Name="LanguageSelector"
                        AutomationProperties.AutomationId="LanguageSelector"
                        HorizontalAlignment="Right"
                        SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem x:Name="LanguageSystemItem" Tag="" />
                        <ComboBoxItem Content="中文（简体）" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                        <ComboBoxItem Content="Русский" Tag="ru-RU" />
                        <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                        <ComboBoxItem Content="Français" Tag="fr-FR" />
                        <ComboBoxItem Content="Español" Tag="es-ES" />
                        <ComboBoxItem Content="Italiano" Tag="it-IT" />
                        <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
                        <ComboBoxItem Content="日本語" Tag="ja-JP" />
                        <ComboBoxItem Content="한국어" Tag="ko-KR" />
                        <ComboBoxItem Content="Polski" Tag="pl-PL" />
                        <ComboBoxItem Content="Українська" Tag="uk-UA" />
                    </ComboBox>
                </controls:SettingsCard>
                <InfoBar
                        x:Name="LanguageRestartInfoBar"
                        IsOpen="False"
                        Visibility="{x:Bind LanguageRestartInfoBar.IsOpen, Mode=OneWay}"
                        IsClosable="True"
                        Severity="Informational">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="RestartNowButton"
                                x:Uid="SettingsRestartNow"
                                Click="RestartNowButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="InteractionHeading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                <controls:SettingsCard x:Name="WheelCard" x:Uid="SettingsMouseWheelBehaviorSelector" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE962;" /></controls:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160" MaxWidth="240"
                        x:Name="MouseWheelBehaviorSelector"
                        AutomationProperties.AutomationId="MouseWheelBehaviorSelector"
                        HorizontalAlignment="Right"
                        SelectionChanged="MouseWheelBehaviorSelector_SelectionChanged">
                        <ComboBoxItem x:Name="MouseWheelNavigateItem" />
                        <ComboBoxItem x:Name="MouseWheelZoomItem" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="TouchCard" x:Uid="SettingsTouchpadGesturesToggle" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7C9;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="TouchpadGesturesToggle"
                        AutomationProperties.AutomationId="TouchpadGesturesToggle"
                        Toggled="TouchpadGesturesToggle_Toggled" />
                </controls:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="ViewingHeading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                <controls:SettingsCard x:Name="InspectorCard" x:Uid="SettingsShowInspectorPanelToggle" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="ShowInspectorPanelToggle"
                        AutomationProperties.AutomationId="ShowInspectorPanelToggle"
                        Toggled="ShowInspectorPanelToggle_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="FilmstripCard" x:Uid="SettingsShowFilmstripToggle" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEB9F;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="ShowFilmstripToggle"
                        AutomationProperties.AutomationId="ShowFilmstripToggle"
                        Toggled="ShowFilmstripToggle_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="GamutCard" x:Uid="SettingsColorGamutMappingModeSelector" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></controls:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="160" MaxWidth="240"
                        x:Name="ColorGamutMappingModeSelector"
                        AutomationProperties.AutomationId="ColorGamutMappingModeSelector"
                        HorizontalAlignment="Right"
                        SelectionChanged="ColorGamutMappingModeSelector_SelectionChanged">
                        <ComboBoxItem x:Name="GamutManagedItem" />
                        <ComboBoxItem x:Name="GamutClipItem" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="PerformanceHeading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                <controls:SettingsCard x:Name="PreloadCard" x:Uid="SettingsPreloadAdjacentImagesToggle" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="PreloadAdjacentImagesToggle"
                        AutomationProperties.AutomationId="PreloadAdjacentImagesToggle"
                        Toggled="PreloadAdjacentImagesToggle_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="RadiusCard" x:Uid="SettingsAdjacentPreloadRadiusBox" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A0;" /></controls:SettingsCard.HeaderIcon>
                    <NumberBox Width="160"
                        x:Name="AdjacentPreloadRadiusBox"
                        AutomationProperties.AutomationId="AdjacentPreloadRadiusBox"
                        Minimum="1"
                        Maximum="12"
                        SmallChange="1"
                        LargeChange="2"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="AdjacentPreloadRadiusBox_ValueChanged" />
                </controls:SettingsCard>
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Name="SystemHeading" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                <controls:SettingsCard x:Name="DefaultAppsCard" Padding="16,12" MinHeight="72">
                    <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A7;" /></controls:SettingsCard.HeaderIcon>
                    <Button x:Name="OpenDefaultAppsSettingsButton" x:Uid="SettingsOpenDefaultAppsButton" AutomationProperties.AutomationId="OpenDefaultAppsSettingsButton" Click="OpenDefaultAppsSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Uid="SettingsDefaultAppsText" /><FontIcon FontSize="12" Glyph="&#xE8A7;" /></StackPanel>
                    </Button>
                </controls:SettingsCard>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
