<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HdrImageViewer.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HdrImageViewer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="AboutPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel
            Grid.Row="1"
            MaxWidth="720"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock
                x:Uid="AboutAppName"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="VersionText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Uid="AboutDescription"
                TextWrapping="WrapWholeWords" />
            <HyperlinkButton
                x:Uid="AboutWeiboLink"
                AutomationProperties.AutomationId="WeiboProfileLink"
                NavigateUri="https://weibo.com/u/6864619718" />
            <TextBlock
                x:Uid="AboutAdobeNotice"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</Page>
