<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HdrImageViewer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HdrImageViewer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:HdrImageViewer.Presentation"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <AcrylicBrush
            x:Key="ViewerChromeAcrylicBrush"
            FallbackColor="{ThemeResource SystemChromeLowColor}"
            TintColor="{ThemeResource SystemChromeLowColor}"
            TintLuminosityOpacity="0.88"
            TintOpacity="0.58" />
        <Style
            x:Key="InspectorLabelTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style
            x:Key="InspectorValueTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style
            x:Key="PhotoToolbarButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="PhotoToolbarToggleButtonStyle"
            BasedOn="{StaticResource DefaultToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="DeleteConfirmationButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style
            x:Key="LivePhotoOverlayButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="LivePhotoOverlayToggleButtonStyle"
            BasedOn="{StaticResource DefaultToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="SideNavigationButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="64" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource ViewerChromeAcrylicBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="FilmstripListViewItemStyle"
            TargetType="ListViewItem">
            <Setter Property="Height" Value="60" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="HomeRoot"
        SizeChanged="HomeRoot_SizeChanged">
        <Grid
            ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="InspectorColumn" Width="352" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="PreviewSurface"
                Background="Transparent"
                ManipulationDelta="PreviewSurface_ManipulationDelta"
                ManipulationMode="Scale"
                PointerCaptureLost="PreviewSurface_PointerCaptureLost"
                PointerMoved="PreviewSurface_PointerMoved"
                PointerPressed="PreviewSurface_PointerPressed"
                PointerReleased="PreviewSurface_PointerReleased"
                PointerWheelChanged="PreviewSurface_PointerWheelChanged"
                SizeChanged="PreviewSurface_SizeChanged">
                <SwapChainPanel
                    x:Name="HdrSwapChainHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    
                    CompositionScaleChanged="HdrSwapChainHost_CompositionScaleChanged"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5"
                    SizeChanged="HdrSwapChainHost_SizeChanged"
                    Visibility="Collapsed">
                    <SwapChainPanel.RenderTransform>
                        <ScaleTransform x:Name="SwapChainZoomPreviewTransform" />
                    </SwapChainPanel.RenderTransform>
                </SwapChainPanel>
                <ScrollViewer
                        x:Name="ImageScroller"
                    Background="Transparent"
                    
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Hidden"
                    ViewChanged="ImageScroller_ViewChanged"
                    ZoomMode="Disabled">
                    <Grid
                        x:Name="ImageViewport"
                        Background="Transparent">
                        <Grid
                            x:Name="ImageSurface"
                            Background="Transparent"
                            HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Name="SaveAsMenuItem"
                                        AutomationProperties.AutomationId="SaveAsMenuItem"
                                        Click="SaveAsMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Ctrl+S"
                                        x:Uid="ContextMenuSaveAs">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Save" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="CopyImageMenuItem"
                                        AutomationProperties.AutomationId="CopyImageMenuItem"
                                        Click="CopyImageMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Ctrl+C"
                                        x:Uid="ContextMenuCopy">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Copy" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="CopyPathMenuItem"
                                        AutomationProperties.AutomationId="CopyPathMenuItem"
                                        Click="CopyPathMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                                        x:Uid="ContextMenuCopyPath">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Document" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="FileInfoMenuItem"
                                        AutomationProperties.AutomationId="FileInfoMenuItem"
                                        Click="FileInfoMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Alt+Enter"
                                        x:Uid="ContextMenuFileInfo">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="DeleteImageMenuItem"
                                        AutomationProperties.AutomationId="DeleteImageMenuItem"
                                        Click="DeleteImageMenuItem_Click"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Delete"
                                        x:Uid="ContextMenuDelete">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Delete" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ImageInteractionScaleTransform" />
                            </Grid.RenderTransform>
                            <Image
                        x:Name="FallbackImage"
                        
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                            <MediaPlayerElement
                                x:Name="LivePhotoPlayer"
                                AreTransportControlsEnabled="False"
                                AutoPlay="False"
                                Canvas.ZIndex="4"
                                Stretch="Fill"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="LivePhotoOverlay"
                                Margin="16"
                                Padding="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource ViewerChromeAcrylicBrush}"
                                BackgroundSizing="InnerBorderEdge"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Canvas.ZIndex="5"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Visibility="{x:Bind local:HomePage.BoolToVisibility(ViewModel.HasCompanionMedia), Mode=OneWay}">
                                <Grid ColumnSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="LivePhotoButton"
                                        AutomationProperties.AutomationId="LivePhotoButton"
                                        
                                        Click="LivePhotoButton_Click"
                                        Style="{StaticResource LivePhotoOverlayButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CompanionMediaSummary, Mode=OneWay}">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="7">
                                            <Grid
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center">
                                                <Ellipse
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.9"
                                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                    StrokeDashArray="1,1.8"
                                                    StrokeThickness="1.4" />
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.7"
                                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                    StrokeThickness="1.2" />
                                                <Ellipse
                                                    Width="3"
                                                    Height="3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{x:Bind ViewModel.CompanionMediaLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Border
                                        Grid.Column="1"
                                        Width="1"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        Opacity="0.7" />
                                    <ToggleButton
                                        x:Name="LivePhotoMuteToggle"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="LivePhotoMuteToggle"
                                        Click="LivePhotoMuteToggle_Click"
                                        IsChecked="{x:Bind ViewModel.IsCompanionMediaMuted, Mode=TwoWay}"
                                        Style="{StaticResource LivePhotoOverlayToggleButtonStyle}"
                                        >
                                        <FontIcon
                                            FontSize="14"
                                            Glyph="{x:Bind local:HomePage.CompanionMuteGlyph(ViewModel.IsCompanionMediaMuted), Mode=OneWay}" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <StackPanel
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="{x:Bind ViewModel.PlaceholderOpacity, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        FontSize="40"
                        Glyph="&#xEB9F;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Border x:Name="ComparisonDivider" Width="32" HorizontalAlignment="Left"
                        Background="Transparent" Visibility="Collapsed"
                         DoubleTapped="ComparisonDivider_DoubleTapped"
                        PointerPressed="ComparisonDivider_PointerPressed"
                        PointerMoved="ComparisonDivider_PointerMoved"
                        PointerReleased="ComparisonDivider_PointerReleased"
                        PointerCaptureLost="ComparisonDivider_PointerCaptureLost">
                    <Grid>
                        <Border Width="3" Background="#66000000" HorizontalAlignment="Center" />
                        <Border Width="1" Background="#E6FFFFFF" HorizontalAlignment="Center" />
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="ComparisonSdrBadge" Canvas.Left="-40" Canvas.Top="12" Padding="8,4" Background="#CC202124" CornerRadius="4">
                                <TextBlock Text="SDR" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border x:Name="ComparisonHdrBadge" Canvas.Left="32" Canvas.Top="12" Padding="8,4" Background="#CC202124" CornerRadius="4">
                                <TextBlock Text="HDR" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </Canvas>
                        <Border Background="#F0202124" BorderBrush="#D9FFFFFF" BorderThickness="1" Height="32" VerticalAlignment="Center" CornerRadius="16">
                            <Grid ColumnSpacing="4" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="White" />
                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="White" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Button
                    x:Name="SidePreviousImageButton"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SidePreviousImageButton"
                    Click="PreviousImage_Click"
                    Style="{StaticResource SideNavigationButtonStyle}">
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE76B;" />
                </Button>
                <Button
                    x:Name="SideNextImageButton"
                    Margin="0,0,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SideNextImageButton"
                    Click="NextImage_Click"
                    Style="{StaticResource SideNavigationButtonStyle}">
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE76C;" />
                </Button>
                <StackPanel
                    x:Name="TopActionBar"
                    Margin="0,18,18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button x:Name="TopBatchExportButton" Click="BatchExport_Click" Style="{StaticResource PhotoToolbarButtonStyle}"
                            AutomationProperties.AutomationId="BatchExportButton">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </Button>
                    <Button x:Name="TopViewerToolsButton" Click="ViewerTools_Click" Style="{StaticResource PhotoToolbarButtonStyle}"
                            AutomationProperties.AutomationId="ViewerToolsButton">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                    </Button>
                    <ToggleButton
                        x:Name="TopInspectorToggleButton"
                        AutomationProperties.AutomationId="TopInspectorToggleButton"
                        
                        Click="TopInspectorToggleButton_Click"
                        Style="{StaticResource PhotoToolbarToggleButtonStyle}"
                        >
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE946;" />
                    </ToggleButton>
                    <Button
                        x:Name="TopCropButton"
                        AutomationProperties.AutomationId="TopCropButton"
                        Click="CropButton_Click"
                        Style="{StaticResource PhotoToolbarButtonStyle}"
                        >
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE7A8;" />
                    </Button>
                    <Button
                        x:Name="TopFullScreenButton"
                        AutomationProperties.AutomationId="TopFullScreenButton"
                        Click="FullScreen_Click"
                        Style="{StaticResource PhotoToolbarButtonStyle}">
                        <FontIcon
                            x:Name="TopFullScreenIcon"
                            FontSize="16"
                            Glyph="&#xE740;" />
                    </Button>
                </StackPanel>
                <Grid
                    x:Name="CropOverlay"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                    <Border
                        x:Name="CropFrame"
                        Width="520"
                        Height="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}"
                        BorderThickness="2"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        PointerMoved="CropFrame_PointerMoved"
                        PointerPressed="CropFrame_PointerPressed"
                        PointerReleased="CropFrame_PointerReleased">
                        <Grid Background="Transparent">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="1"
                                    Height="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                                <Border
                                    Grid.Row="2"
                                    Height="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                            </Grid>
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="1"
                                    Width="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                                <Border
                                    Grid.Column="2"
                                    Width="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Thumb
                                x:Name="CropTopThumb"
                                Height="20"
                                Margin="32,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="CropTopThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Top" />
                            <Thumb
                                x:Name="CropBottomThumb"
                                Height="20"
                                Margin="32,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="CropBottomThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Bottom" />
                            <Thumb
                                x:Name="CropLeftThumb"
                                Width="20"
                                Margin="0,32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="CropLeftThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Left" />
                            <Thumb
                                x:Name="CropRightThumb"
                                Width="20"
                                Margin="0,32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="CropRightThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Right" />
                            <Thumb
                                x:Name="CropTopLeftThumb"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="CropTopLeftThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="TopLeft" />
                            <Thumb
                                x:Name="CropTopRightThumb"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="CropTopRightThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="TopRight" />
                            <Thumb
                                x:Name="CropBottomLeftThumb"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="CropBottomLeftThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="BottomLeft" />
                            <Thumb
                                x:Name="CropBottomRightThumb"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="CropBottomRightThumb"
                                
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="BottomRight" />
                        </Grid>
                    </Border>
                    <Border
                        Padding="12,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,88"
                        Background="{ThemeResource ViewerChromeAcrylicBrush}"
                        BackgroundSizing="InnerBorderEdge"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="CropHeader" />
                            <ComboBox
                                x:Name="CropExportModeSelector"
                                AutomationProperties.AutomationId="CropExportModeSelector"
                                
                                Width="240"
                                SelectedIndex="0"
                                SelectionChanged="CropExportModeSelector_SelectionChanged">
                                <ComboBoxItem x:Name="CropModeSdrPreviewItem" x:Uid="CropModeSdrPreview" />
                                <ComboBoxItem x:Name="CropModeGainMapPreserveItem" x:Uid="CropModeGainMapLossless" />
                                <ComboBoxItem x:Name="CropModeUltraHdrConvertItem" x:Uid="CropModeConvertToUltraHdr" />
                                <ComboBoxItem x:Name="CropModeSingleLayerHdrItem" x:Uid="CropModeSingleLayerHdr" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CropHdrTransferSelector"
                                AutomationProperties.AutomationId="CropHdrTransferSelector"
                                
                                Width="96"
                                SelectedIndex="0"
                                SelectionChanged="CropHdrTransferSelector_SelectionChanged"
                                Visibility="Collapsed">
                                <ComboBoxItem Content="PQ HDR10" />
                                <ComboBoxItem Content="HLG" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CropUltraHdrGainMapModeSelector"
                                AutomationProperties.AutomationId="CropUltraHdrGainMapModeSelector"
                                
                                Width="128"
                                SelectedIndex="0"
                                SelectionChanged="CropUltraHdrGainMapModeSelector_SelectionChanged"
                                Visibility="Collapsed">
                                <ComboBoxItem x:Name="CropUltraHdrMonoItem" x:Uid="CropUltraHdrMonochrome" />
                                <ComboBoxItem Content="RGB Gain-map" />
                            </ComboBox>
                            <ComboBox
                                x:Name="CropUltraHdrBaseGamutSelector"
                                AutomationProperties.AutomationId="CropUltraHdrBaseGamutSelector"
                                
                                Width="128"
                                SelectedIndex="0"
                                IsEnabled="False"
                                SelectionChanged="CropUltraHdrBaseGamutSelector_SelectionChanged"
                                Visibility="Collapsed">
                                <ComboBoxItem x:Name="CropUltraHdrBaseGamutP3Item" x:Uid="CropUltraHdrBaseGamutP3" />
                            </ComboBox>
                            <Button
                                x:Name="CancelCropButton"
                                AutomationProperties.AutomationId="CancelCropButton"
                                Click="CancelCrop_Click"
                                x:Uid="CropCancel" />
                            <Button
                                x:Name="ApplyCropButton"
                                AutomationProperties.AutomationId="ApplyCropButton"
                                Click="ApplyCrop_Click"
                                x:Uid="CropApply" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border
                    x:Name="PhotoToolbarOverlay"
                    PointerEntered="ViewerChrome_PointerEntered"
                    PointerExited="ViewerChrome_PointerExited"
                    GotFocus="ViewerChrome_GotFocus"
                    MaxWidth="1180"
                    Margin="16,0,16,16"
                    Padding="12,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource ViewerChromeAcrylicBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PhotoToolbarOverlayTransform" Y="0" />
                    </Border.RenderTransform>
                    <Grid
                        x:Name="PhotoCommandsGrid"
                        HorizontalAlignment="Stretch"
                        ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="OpenImageButton"
                            AutomationProperties.AutomationId="OpenImageButton"
                            Click="OpenImage_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}">
                            <SymbolIcon Symbol="OpenFile" />
                        </Button>
                        <Button
                            x:Name="ReloadImageButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ReloadImageButton"
                            
                            Click="ReloadImage_Click"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Border
                            Grid.Column="2"
                            Width="1"
                            Margin="0,8"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            x:Name="PreviousImageButton"
                            Grid.Column="3"
                            AutomationProperties.AutomationId="PreviousImageButton"
                            Click="PreviousImage_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE76B;" />
                        </Button>
                        <TextBlock
                            x:Name="FolderPositionText"
                            Grid.Column="4"
                            MinWidth="38"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="0 / 0"
                            TextAlignment="Center" />
                        <Grid
                            x:Name="FilmstripRow"
                            Grid.Column="5"
                            Height="64"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed">
                            <ListView
                                x:Name="ImageFilmstrip"
                                Height="64"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ImageFilmstrip"
                                ContainerContentChanging="ImageFilmstrip_ContainerContentChanging"
                                Background="Transparent"
                                BorderThickness="0"
                                IsItemClickEnabled="True"
                                ItemClick="ImageFilmstrip_ItemClick"
                                ItemContainerStyle="{StaticResource FilmstripListViewItemStyle}"
                                ItemsSource="{x:Bind FilmstripItems, Mode=OneWay}"
                                SelectionMode="Single"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.HorizontalScrollMode="Enabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:FilmstripImageItem">
                                        <Grid
                                            Width="{x:Bind PreviewWidth, Mode=OneWay}"
                                            Height="56"
                                            SizeChanged="FilmstripThumbnail_SizeChanged"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind PreviewDescription, Mode=OneWay}">
                                            <Border
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                                IsHitTestVisible="False"
                                                Visibility="{x:Bind local:HomePage.BoolToVisibility(IsCurrent), Mode=OneWay}" />
                                            <Border
                                                Margin="4"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ControlCornerRadius}">
                                                <Grid>
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Glyph="{x:Bind local:HomePage.ThumbnailPlaceholderGlyph(HasLoadError), Mode=OneWay}"
                                                        Visibility="{x:Bind local:HomePage.InverseBoolToVisibility(HasThumbnail), Mode=OneWay}" />
                                                    <Image
                                                        AutomationProperties.Name="{x:Bind FileName}"
                                                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                        Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <TextBlock
                            x:Name="FolderFileNameText"
                            Grid.Column="5"
                            MinWidth="0"
                            ToolTipService.ToolTip="{x:Bind ViewModel.FileName, Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="NextImageButton"
                            Grid.Column="6"
                            AutomationProperties.AutomationId="NextImageButton"
                            Click="NextImage_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE76C;" />
                        </Button>
                        <Border
                            Grid.Column="7"
                            Width="1"
                            Margin="0,8"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            x:Name="CropButton"
                            Grid.Column="8"
                            AutomationProperties.AutomationId="CropButton"
                            Click="CropButton_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE7A8;" />
                        </Button>
                        <Button
                            x:Name="SingleLayerHdrSaveAsButton"
                            Grid.Column="9"
                            AutomationProperties.AutomationId="SingleLayerHdrSaveAsButton"
                            
                            Click="SingleLayerHdrSaveAs_Click"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <SymbolIcon Symbol="Save" />
                        </Button>
                        <Button
                            x:Name="ZoomOutButton"
                            Grid.Column="10"
                            AutomationProperties.AutomationId="ZoomOutButton"
                            
                            Click="ZoomOut_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE71F;" />
                        </Button>
                        <TextBlock
                            x:Name="ZoomLevelText"
                            Grid.Column="11"
                            MinWidth="54"
                            HorizontalAlignment="Center"
                            Text="100%"
                            TextAlignment="Center"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="ZoomInButton"
                            Grid.Column="12"
                            AutomationProperties.AutomationId="ZoomInButton"
                            
                            Click="ZoomIn_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE8A3;" />
                        </Button>
                        <Button
                            x:Name="ActualSizeButton"
                            Grid.Column="13"
                            AutomationProperties.AutomationId="ActualSizeButton"
                            
                            Click="ActualSize_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="1:1" />
                        </Button>
                        <Button
                            x:Name="ZoomFitButton"
                            Grid.Column="14"
                            AutomationProperties.AutomationId="ZoomFitButton"
                            
                            Click="ZoomFit_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE9A6;" />
                        </Button>
                        <Button
                            x:Name="FullScreenButton"
                            Grid.Column="15"
                            AutomationProperties.AutomationId="FullScreenButton"
                            Click="FullScreen_Click"
                            Visibility="Collapsed"
                            Style="{StaticResource PhotoToolbarButtonStyle}">
                            <FontIcon
                                x:Name="FullScreenIcon"
                                FontSize="16"
                                Glyph="&#xE740;" />
                        </Button>
                        <Button
                            x:Name="ZoomFillButton"
                            Grid.Column="16"
                            AutomationProperties.AutomationId="ZoomFillButton"
                            
                            Click="ZoomFill_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            >
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE9A7;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="InspectorPanel"
                Grid.Column="1"
                Margin="12,12,16,12"
                Padding="16"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InspectorPanelTransform" />
                </Border.RenderTransform>
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <SelectorBar x:Name="InspectorSectionSelector" AutomationProperties.AutomationId="InspectorSectionSelector" SelectionChanged="InspectorSection_SelectionChanged">
                        <SelectorBarItem x:Name="InspectorDetailsTab" x:Uid="InspectorTabDetails" IsSelected="True" />
                        <SelectorBarItem x:Name="InspectorAnalysisTab" x:Uid="InspectorTabAnalysis" />
                        <SelectorBarItem x:Name="InspectorGamutTab" x:Uid="InspectorTabGamut" />
                    </SelectorBar>
                <ScrollViewer Grid.Row="1"
                    x:Name="InspectorScroll"
                    
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                <StackPanel
                    Margin="0,0,24,4"
                    Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                x:Uid="InspectorDetailsHeader" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.FormatName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.HdrKind, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Expander
                        x:Name="FileExpander"
                        x:Uid="InspectorSectionFile"
                        HorizontalAlignment="Stretch"
                        IsExpanded="True">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="InspectorLabelFormat" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.FormatName, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" x:Uid="InspectorLabelDecoder" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.Decoder, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander
                        Header="EXIF"
                        HorizontalAlignment="Stretch"
                        IsExpanded="False">
                        <TextBlock
                            Style="{StaticResource InspectorValueTextStyle}"
                            Text="{x:Bind ViewModel.ExifSummary, Mode=OneWay}" />
                    </Expander>

                    <Expander
                        Header="HDR"
                        HorizontalAlignment="Stretch"
                        IsExpanded="True">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="InspectorLabelType" Style="{StaticResource InspectorLabelTextStyle}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.HdrKind, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" x:Uid="InspectorLabelCurve" Style="{StaticResource InspectorLabelTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.TransferFunction, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" x:Uid="InspectorLabelColor" Style="{StaticResource InspectorLabelTextStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.ColorContainer, Mode=OneWay}" />
                        </Grid>
                    </Expander>

                    <Expander
                        x:Name="DisplayModeExpander"
                        x:Uid="InspectorSectionDisplayMode"
                        HorizontalAlignment="Stretch"
                        IsExpanded="True">
                        <StackPanel Spacing="12">
                            <ComboBox
                                x:Name="HdrPreviewModeSelector"
                                AutomationProperties.AutomationId="HdrPreviewModeSelector"
                                
                                HorizontalAlignment="Stretch"
                                SelectedIndex="1"
                                SelectionChanged="HdrPreviewModeSelector_SelectionChanged">
                                <ComboBoxItem Content="SDR" />
                                <ComboBoxItem Content="Adaptive" />
                                <ComboBoxItem Content="Alternate Image" />
                                <ComboBoxItem Content="Gain Map" />
                            </ComboBox>
                            <Grid
                                x:Name="SdrWhitePanel"
                                ColumnSpacing="8"
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="SdrWhiteHeaderLabel"
                                    Grid.ColumnSpan="2"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    x:Name="SdrWhiteOverrideToggle"
                                    Grid.Row="1"
                                    AutomationProperties.AutomationId="SdrWhiteOverrideToggle"
                                    MinWidth="0"
                                    IsOn="False"
                                    Toggled="SdrWhiteOverrideToggle_Toggled" />
                                <TextBlock
                                    x:Name="SdrWhiteValueText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap"
                                    x:Uid="InspectorAbsolute203Nits" />
                            </Grid>
                            <Slider
                                x:Name="SdrWhiteSlider"
                                AutomationProperties.AutomationId="SdrWhiteSlider"
                                
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                LargeChange="10"
                                Maximum="600"
                                Minimum="80"
                                SmallChange="1"
                                StepFrequency="1"
                                Value="203"
                                ValueChanged="SdrWhiteSlider_ValueChanged"
                                Visibility="Collapsed" />
                            <ComboBox
                                x:Name="HdrHeadroomModeSelector"
                                AutomationProperties.AutomationId="HdrHeadroomModeSelector"
                                
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="HdrHeadroomModeSelector_SelectionChanged">
                                <ComboBoxItem Content="System Auto" />
                                <ComboBoxItem Content="Manual Override" />
                                <ComboBoxItem Content="ABL Simulation" IsEnabled="False" />
                            </ComboBox>
                            <Grid
                                x:Name="HdrGainPanel"
                                RowSpacing="6"
                                Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="HdrGainSlider"
                                        AutomationProperties.AutomationId="HdrGainSlider"
                                        
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="True"
                                        LargeChange="100"
                                        Maximum="4000"
                                        Minimum="100"
                                        SmallChange="10"
                                        StepFrequency="10"
                                        Value="1000"
                                        ValueChanged="HdrGainSlider_ValueChanged" />
                                    <Button
                                        Grid.Column="1"
                                        x:Name="ResetHdrGainToDisplayPeakButton"
                                        AutomationProperties.AutomationId="ResetHdrGainToDisplayPeakButton"
                                        Click="ResetHdrGainToDisplayPeak_Click"
                                        x:Uid="InspectorReset" />
                                </Grid>
                                <TextBlock
                                    x:Name="HdrGainValueText"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="1000 nits" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander
                        x:Name="DiagnosticsExpander"
                        x:Uid="InspectorSectionDiagnostic"
                        HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="InspectorLabelPath" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" x:Uid="InspectorLabelSupport" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.SupportStatus, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" x:Uid="InspectorLabelSignal" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.GainMapStatus, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" x:Uid="InspectorLabelLocation" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.GainMapLocation, Mode=OneWay}" />
                                <TextBlock Grid.Row="4" x:Uid="InspectorLabelMetadata" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.GainMapMetadata, Mode=OneWay}" />
                                <TextBlock Grid.Row="5" x:Uid="InspectorLabelContainer" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.JpegMetadata, Mode=OneWay}" />
                                <TextBlock Grid.Row="6" x:Uid="InspectorLabelLive" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.CompanionMediaSummary, Mode=OneWay}" />
                                <TextBlock Grid.Row="7" x:Uid="InspectorLabelVideoHdr" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.CompanionVideoHdrSummary, Mode=OneWay}" />
                                <TextBlock Grid.Row="8" x:Uid="InspectorLabelVideo" Style="{StaticResource InspectorLabelTextStyle}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.CompanionVideoStatus, Mode=OneWay}" />
                            </Grid>
                            <TextBox
                                MinHeight="120"
                                AcceptsReturn="True"
                                x:Name="RenderStatusTextBox"
                                AutomationProperties.AutomationId="RenderStatusTextBox"
                                Background="Transparent"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.RenderStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="GamutToolsPanel" Grid.Row="1" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,4" Spacing="16">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="GamutDistributionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="GamutSubtitleText" x:Uid="GamutDistributionSubtitle" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="RefreshGamutButton" Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                    Click="RefreshAnalysis_Click" >
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <CheckBox x:Name="GamutComparisonToggle" IsEnabled="False" HorizontalAlignment="Stretch"
                                  Checked="GamutComparison_Changed" Unchecked="GamutComparison_Changed">
                            <TextBlock x:Uid="GamutComparisonLabel" TextWrapping="Wrap" />
                        </CheckBox>
                        <Border x:Name="GamutPlotSurface" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
                            <Canvas x:Name="ChromaticityCanvas" Height="288" SizeChanged="Chromaticity_SizeChanged" ActualThemeChanged="Chromaticity_ActualThemeChanged"
                                     />
                        </Border>
                        <Grid x:Name="GamutComparisonLegend" Visibility="Collapsed" ColumnSpacing="8">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Default">
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource ControlFillColorSecondary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ControlFillColorTertiary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ControlFillColorTertiary}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource TextFillColorSecondary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource ControlFillColorSecondary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ControlFillColorTertiary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ControlFillColorTertiary}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource TextFillColorSecondary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast">
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="GamutSdrLayerToggle" IsChecked="True" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,4"
                                          AutomationProperties.Name="SDR Base" ToolTipService.ToolTip="SDR Base"
                                          Checked="GamutLayer_Changed" Unchecked="GamutLayer_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="GamutSdrSwatch" Width="8" Height="8" />
                                    <TextBlock Text="SDR" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="GamutAlternateLayerToggle" Grid.Column="1" IsChecked="True" HorizontalAlignment="Stretch" MinWidth="0" Padding="8,4"
                                          AutomationProperties.Name="HDR Alternate Image" ToolTipService.ToolTip="HDR · Alternate Image"
                                          Checked="GamutLayer_Changed" Unchecked="GamutLayer_Changed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="GamutAlternateSwatch" Width="8" Height="8" />
                                    <TextBlock Text="HDR" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse x:Name="GamutOverlapSwatch" Width="8" Height="8" />
                                <TextBlock x:Uid="GamutComparisonOverlap" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="SrgbBoundaryToggle" Content="sRGB" IsChecked="True" MinWidth="0"
                                      Checked="GamutBoundary_Changed" Unchecked="GamutBoundary_Changed"  />
                            <CheckBox x:Name="P3BoundaryToggle" Grid.Column="1" Content="P3" IsChecked="True" MinWidth="0"
                                      Checked="GamutBoundary_Changed" Unchecked="GamutBoundary_Changed"  />
                            <CheckBox x:Name="Bt2020BoundaryToggle" Grid.Column="2" Content="2020" IsChecked="True" MinWidth="0"
                                      Checked="GamutBoundary_Changed" Unchecked="GamutBoundary_Changed"  />
                        </Grid>
                        <TextBlock x:Name="GamutSummaryText" x:Uid="GamutSummaryText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel x:Name="GamutSamplePanel" Spacing="8">
                            <TextBlock x:Uid="GamutRecentSampleTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ChromaticitySampleText" x:Uid="ChromaticitySampleText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="ChromaticityGamutText" x:Uid="ChromaticityGamutText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="GamutAboutButton" x:Uid="GamutAboutButton" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel MaxWidth="280" Spacing="12">
                                        <TextBlock x:Name="GamutAboutDescriptionText" x:Uid="GamutAboutDescription" TextWrapping="Wrap" />
                                        <TextBlock x:Name="GamutAboutDataSourceText" x:Uid="GamutCieNotice" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <HyperlinkButton x:Uid="GamutCieDataSource" NavigateUri="https://doi.org/10.25039/CIE.DS.xvudnb9b" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ViewerToolsPanel" Grid.Row="1" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <!-- Reserve a gutter for WinUI overlay scrollbars, including the expanded thumb. -->
                    <StackPanel Margin="0,0,24,4" Spacing="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="HistogramTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="HistogramSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="RefreshAnalysisButton" Grid.Column="1" Click="RefreshAnalysis_Click" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                        >
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,8,8,0">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Height="128">
                                        <Canvas x:Name="LuminanceHistogram" SizeChanged="Histogram_SizeChanged" ActualThemeChanged="Histogram_ActualThemeChanged"
                                                 />
                                        <TextBlock x:Name="HistogramEmptyText" x:Uid="HistogramEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="SDR" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <TextBlock Text="HDR" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="2" Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="R" Foreground="#F16B70" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="G" Foreground="#54BA83" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="B" Foreground="#63A4ED" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HistogramWhiteText" x:Uid="HistogramWhiteText" HorizontalAlignment="Right"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="HistogramAvgLuminance" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AverageLuminanceText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Uid="HistogramPeakLuminance" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PeakLuminanceText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AnalysisSummary" x:Uid="AnalysisSummary" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock x:Uid="AnalysisScreenAssist" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button x:Name="ResetViewerToolsButton" HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0" IsEnabled="False" Click="ResetViewerTools_Click"
                                        >
                                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                                </Button>
                            </Grid>
                            <ToggleButton x:Name="ComparisonToggle" HorizontalAlignment="Stretch" MinHeight="36" Padding="8,4"
                                          
                                          Checked="ViewerToolSetting_Click" Unchecked="ViewerToolSetting_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE745;" FontSize="14" />
                                    <TextBlock x:Uid="AnalysisSplitScreenText" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel x:Name="ComparisonControls" Visibility="Collapsed" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ComparisonPositionText" Text="SDR 50% · HDR 50%" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="CenterComparisonButton" Grid.Column="1" x:Uid="AnalysisCenterComparison" Padding="8,4" Background="Transparent" BorderThickness="0" Click="CenterComparison_Click" />
                                </Grid>
                                <Slider x:Name="ComparisonSlider" Minimum="0" Maximum="100" Value="50" StepFrequency="1"
                                         ValueChanged="ComparisonSlider_ValueChanged" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="AnalysisPixelSamplingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <TextBlock x:Name="PixelSampleText" x:Uid="PixelSampleText" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="AnalysisAboutValuesButton" x:Uid="AnalysisAboutValuesButton" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock x:Name="AnalysisAboutValuesText" x:Uid="AnalysisAboutValuesDescription" MaxWidth="280" TextWrapping="Wrap" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="ExportProgressOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="20"
            Visibility="Collapsed">
            <Border
                Width="420"
                MaxWidth="420"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="ExportProgressRing"
                            Width="32"
                            Height="32"
                            IsActive="False" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                x:Name="ExportProgressTitleText"
                                FontWeight="SemiBold"
                                x:Uid="ExportOverlayTitle" />
                            <TextBlock
                                x:Name="ExportProgressDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                x:Uid="ExportOverlayPreparing"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar
                        x:Name="ExportProgressBar"
                        IsIndeterminate="True" />
                    <Button x:Name="CancelExportButton"
                            x:Uid="ExportOverlayCancel"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="CancelExportButton"
                            Click="CancelExport_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
